# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # 서버 전용(클라이언트 노출 금지)

# ── Resend (요구사항 5,10) ─────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM="Kepler <billing@your-domain.com>"

# ── 크론 보안 토큰 (요구사항 6,10) ─────────────────────────
CRON_SECRET=generate-a-long-random-string

# ── 케플러 외부 프로그램 링크 (요구사항 4) ─────────────────
NEXT_PUBLIC_ENGLISH_PRO_URL=https://english-pro.kepler.example
NEXT_PUBLIC_MATH_PRO_URL=https://math-pro.kepler.example

# ── (선택) Google Calendar ─────────────────────────────────
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
